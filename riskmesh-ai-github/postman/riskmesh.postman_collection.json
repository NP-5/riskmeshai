            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{api_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"10.00\",\n  \"currency\": \"USD\",\n  \"invoice_id\": \"INV-1001\",\n  \"custom_id\": \"buyer-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "sandbox: capture order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/sandbox/capture/{{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "sandbox",
                "capture",
                "{{order_id}}"
              ],
              "query": [
                {
                  "key": "mock",
                  "value": ""
                }
              ]
            },
            "description": "Role: admin. Optional ?mock=CODE sets the PayPal mock-response header.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{api_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device\": \"dev-1\",\n  \"ip\": \"203.0.113.5\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
