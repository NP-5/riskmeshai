{
  "info": {
    "name": "RiskMesh AI API",
    "description": "RiskMesh AI: multi-agent payout-ring detection with human approval. Set base_url and api_token (a token from RISKMESH_API_TOKENS).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "api_token",
      "value": ""
    },
    {
      "key": "subject_id",
      "value": ""
    },
    {
      "key": "investigation_id",
      "value": ""
    },
    {
      "key": "action_id",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "capture_id",
      "value": ""
    },
    {
      "key": "item_id",
      "value": ""
    },
    {
      "key": "batch_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "healthz",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/healthz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "healthz"
              ]
            },
            "description": "Role: public.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "readyz",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/readyz",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "readyz"
              ]
            },
            "description": "Role: public. 503 when DB or webhook verification is unusable.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Session",
      "item": [
        {
          "name": "me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "me"
              ]
            },
            "description": "Role: viewer.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{api_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "config (no secrets)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/config",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "config"
              ]
            },
            "description": "Role: viewer.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{api_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Investigations",
      "item": [
        {
          "name": "list subjects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/subjects",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "subjects"
              ]
            },
            "description": "Role: viewer.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{api_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "list investigations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/investigations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "investigations"
              ]
            },
            "description": "Role: viewer.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{api_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "investigate beneficiary",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/investigations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "investigations"
              ]
            },
            "description": "Role: analyst. HOLD only creates PENDING requests for a human.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{api_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subject_type\": \"beneficiary\",\n  \"subject_id\": \"{{subject_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "get investigation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/investigations/{{investigation_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "investigations",
                "{{investigation_id}}"
              ]
            },
            "description": "Role: viewer.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{api_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "agent trace",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/investigations/{{investigation_id}}/trace",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "investigations",
                "{{investigation_id}}",
                "trace"
              ]
            },
            "description": "Role: viewer.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{api_token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Actions (human approval)",
      "item": [
        {
          "name": "list pending actions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/actions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "actions"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING"
                }
              ]
            },
            "description": "Role: viewer.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{api_token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "approve action",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/actions/{{action_id}}/approve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "actions",
                "{{action_id}}",
                "approve"
              ]
            },
            "description": "Role: reviewer. Executes the PayPal sandbox cancel after the evidence re-check. Reviewer role only.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{api_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Evidence reviewed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "reject action",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/actions/{{action_id}}/reject",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "actions",
                "{{action_id}}",
                "reject"
              ]
            },
            "description": "Role: reviewer.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{api_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"False positive\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
